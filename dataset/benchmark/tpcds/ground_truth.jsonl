STOMER"}, {"referencing_table": "CATALOG_SALES", "referencing_column": "cs_sold_date_sk", "referred_table": "DATE_DIM"}, {"referencing_table": "CATALOG_SALES", "referencing_column": "cs_item_sk", "referred_table": "ITEM"}, {"referencing_table": "CATALOG_SALES", "referencing_column": "cs_bill_customer_sk", "referred_table": "CUSTOMER"}]}, "ground_truth_distributions": {"STORE_SALES.ss_quantity": {"family": "uniform", "params": {"low": 1.0, "high": 100.0}}, "STORE_SALES.ss_net_paid": {"family": "normal", "params": {"mean": 50.0, "std": 30.0}}, "WEB_SALES.ws_quantity": {"family": "uniform", "params": {"low": 1.0, "high": 100.0}}, "CATALOG_SALES.cs_quantity": {"family": "uniform", "params": {"low": 1.0, "high": 100.0}}, "ITEM.i_current_price": {"family": "lognormal", "params": {"mu": 3.5, "sigma": 1.2}}}}
{"id": "tpcds-004", "level": "intermediate", "nl_description": "Decision support schema for a multi-channel retailer. There is a time dimension at second granularity (86400 entries per day, keyed by seconds-since-midnight) with hour, minute, AM/PM, shift classification, and meal time annotation. The date dimension has full calendar and fiscal attributes. Promotions describe special offers linked to specific dates, items, and channels -- each promotion has a response type (email, post, TV, radio, press, internet) and is tied to a cost. Warehouses store inventory. The inventory table tracks on-hand quantities per item per warehouse per date -- this is a large table. Reasons encode return reasons. Ship mode records the twenty available shipping methods. The store sales and store returns fact tables share the ticket number as a linkage key; a return can reference the original sale.", "ground_truth_schema": {"tables": [{"name": "DATE_DIM", "pk": "d_date_sk", "columns": [{"name": "d_date_sk", "data_type": "INT"}, {"name": "d_date_id", "data_type": "VARCHAR"}, {"name": "d_date", "data_type": "DATE"}, {"name": "d_month_seq", "data_type": "INT"}, {"name": "d_year", "data_type": "INT"}, {"name": "d_dow", "data_type": "INT"}, {"name": "d_moy", "data_type": "INT"}, {"name": "d_dom", "data_type": "INT"}, {"name": "d_holiday", "data_type": "VARCHAR"}, {"name": "d_weekend", "data_type": "VARCHAR"}, {"name": "d_fy_year", "data_type": "INT"}, {"name": "d_fy_quarter_seq", "data_type": "INT"}]}, {"name": "TIME_DIM", "pk": "t_time_sk", "columns": [{"name": "t_time_sk", "data_type": "INT"}, {"name": "t_time_id", "data_type": "VARCHAR"}, {"name": "t_time", "data_type": "INT"}, {"name": "t_hour", "data_type": "INT"}, {"name": "t_minute", "data_type": "INT"}, {"name": "t_second", "data_type": "INT"}, {"name": "t_am_pm", "data_type": "VARCHAR"}, {"name": "t_shift", "data_type": "VARCHAR"}, {"name": "t_sub_shift", "data_type": "VARCHAR"}, {"name": "t_meal_time", "data_type": "VARCHAR"}]}, {"